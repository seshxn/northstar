{
  "name": "northstar",
  "version": "0.1.0",
  "description": "Agent orchestration for issue-driven development workflows.",
  "type": "module",
  "bin": {
    "northstar": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run typecheck:web && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:mock": "tsx scripts/mock-server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "spec:check": "tsx scripts/spec-checklist.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.126",
    "@aws-sdk/client-bedrock-runtime": "^3.798.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/geist-mono": "^5.2.5",
    "@fontsource/geist-sans": "^5.2.5",
    "@google/genai": "^1.0.0",
    "@octokit/rest": "^21.1.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@slack/web-api": "^7.8.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^13.1.0",
    "fastify": "^5.2.1",
    "framer-motion": "^12.38.0",
    "liquidjs": "^10.21.1",
    "lucide-react": "^0.468.0",
    "pino": "^9.6.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18",
    "undici": "^7.8.0",
    "vite": "^7.3.2",
    "wouter": "^3.9.0",
    "yaml": "^2.7.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "prettier": "^3.8.3",
    "tmp-promise": "^3.0.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
